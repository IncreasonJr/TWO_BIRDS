# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# OneSignal Configuration (Client-side App ID)
VITE_ONESIGNAL_APP_ID=your-onesignal-app-id-here

# Note: ONESIGNAL_REST_API_KEY is an administrative secret and MUST NOT be prefixed
# with VITE_ or exposed to the client. It is configured in Supabase Edge Functions Secrets.
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key-here

# Paystack Configuration
# Client-side Public Test Key and Plan Code (GHS 47.34 = 4734 pesewas)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_PAYSTACK_PLAN_CODE=PLN_xxxxxxxxxxxx

# Paystack Secret Key (Configured in Supabase Edge Function Secrets - NEVER prefix with VITE_)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

